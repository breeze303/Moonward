{
  "name": "moonward",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.ts --dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "admin:create": "node --env-file-if-exists=.env server/admin.ts",
    "backup": "node --env-file-if-exists=.env server/backup.ts",
    "type": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "better-auth": "1.7.26",
    "clsx": "2.1.1",
    "express": "5.3.0",
    "katex": "0.18.2",
    "lucide-react": "1.77.0",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "12.3.0",
    "micromark-extension-cjk-friendly": "2.0.2",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "parse5": "8.0.1",
    "pg": "^8.23.1",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "undici": "7.28.0",
    "zod": "^4.4.0"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/express": "^5.0.0",
    "@types/katex": "^0.16.0",
    "@types/mdast": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/prismjs": "^1.26.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^6.0.0",
    "vite": "8.3.8"
  }
}
