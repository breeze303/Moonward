# Moonward Docker Compose configuration (reference only).
# First installation: run `node deploy/init-env.mjs` to create a private .env.
# Do not copy another installation's keys, database passwords or API credentials.

# Host-side listener. Keep loopback for a reverse proxy on this machine.
BIND_IP=127.0.0.1
PUBLISH_PORT=18091

# Exact browser origin: scheme, hostname and non-default port, with no path.
# For a remote deployment, use HTTPS, e.g. https://chat.example.com.
APP_ORIGIN=http://localhost:18091
# Optional comma-separated browser origins with the same scheme as APP_ORIGIN.
APP_ALLOWED_ORIGINS=
# Optional trusted reverse proxy IP or CIDR. Leave empty for direct connections.
TRUST_PROXY=

# Required. The generator sets an independent random 32-byte hex value for each.
# Back up AUTH_SECRET with the database: it also protects stored gateway keys.
AUTH_SECRET=
APP_DB_PASSWORD=
POSTGRES_PASSWORD=
